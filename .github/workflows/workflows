build:
  name: 'Build'
  runs-on: ubuntu-latest
  steps:
    - name: 'Checkout Code'
      uses: actions/checkout@v5
    - name: 'Setup Node'
      uses: actions/setup-node@v6
      with:
        node-version: '22'
    - name: 'Build Website'
      run: npm ci && npm run build
    - name: 'Upload artifact'
      uses: actions/upload-pages-artifact@v4
      with:
        path: ./doc
